---
import { languages, type Lang } from "../i18n/ui";
import { getLang, localizedPath, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const navItems = [
  { href: "#about", id: "about", label: t("nav.about") },
  { href: "#projects", id: "projects", label: t("nav.projects") },
  { href: "#skills", id: "skills", label: t("nav.skills") },
  { href: "#experience", id: "experience", label: t("nav.experience") },
  { href: "#contact", id: "contact", label: t("nav.contact") },
];

const langLinks = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: localizedPath(code),
  name: languages[code],
  label: useTranslations(code)("a11y.switchLang"),
  current: code === lang,
}));
---

<header id="site-header" class="site-header sticky top-0 z-20 border-b border-line bg-bg/90 backdrop-blur-sm">
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-1 px-6 py-3 lg:py-4"
    aria-label={t("a11y.mainNav")}
  >
    <a href="#top" data-home-link class="mr-auto font-mono text-lg font-bold text-fg no-underline">
      Miłosz Baron<span class="cursor-blink text-accent">_</span>
    </a>

    <ul
      data-nav-list
      class="nav-scroll order-last -mx-4 flex w-[calc(100%+2rem)] overflow-x-auto px-2 py-1 text-sm font-medium sm:text-[0.9375rem] lg:order-0 lg:mx-0 lg:w-auto lg:gap-1 lg:overflow-visible lg:px-0 lg:py-0"
    >
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link={item.id}
              class="inline-flex min-h-11 items-center px-2 whitespace-nowrap text-muted no-underline transition-colors hover:text-fg sm:px-3"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <span class="hidden h-5 w-px bg-border lg:block" aria-hidden="true"></span>

    <ul class="flex items-center gap-0.5 rounded-full border border-line p-0.5 font-mono text-xs">
      {
        langLinks.map((link) => (
          <li>
            <a
              href={link.href}
              hreflang={link.code}
              lang={link.code}
              title={link.label}
              aria-current={link.current ? "true" : undefined}
              class:list={[
                "inline-flex h-8 min-w-11 items-center justify-center gap-1.5 rounded-full px-2.5 uppercase tracking-wider no-underline transition-colors",
                link.current ? "bg-surface text-fg" : "text-muted hover:text-fg",
              ]}
            >
              {link.current && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />}
              {link.code}
              <span class="sr-only"> — {link.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div id="scroll-progress" class="absolute -bottom-px left-0 h-0.5 w-full origin-left bg-accent" aria-hidden="true"></div>
</header>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  const sections = Array.from(links)
    .map((link) => document.getElementById(link.dataset.navLink ?? ""))
    .filter((section): section is HTMLElement => section !== null);

  const navList = document.querySelector<HTMLElement>("[data-nav-list]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function setActive(id: string) {
    if (id === "" && navList) {
      navList.scrollTo({ left: 0, behavior: reduceMotion.matches ? "auto" : "smooth" });
    }

    links.forEach((link) => {
      const isActive = link.dataset.navLink === id;
      link.classList.toggle("text-fg", isActive);
      link.classList.toggle("text-muted", !isActive);

      if (isActive) centerInNav(link);
    });
  }

  function centerInNav(link: HTMLElement) {
    if (!navList || navList.scrollWidth <= navList.clientWidth) return;
    const left = link.offsetLeft - (navList.clientWidth - link.offsetWidth) / 2;
    navList.scrollTo({ left, behavior: reduceMotion.matches ? "auto" : "smooth" });
  }

  navList?.addEventListener("focusin", (event) => {
    if (event.target instanceof HTMLElement) centerInNav(event.target);
  });

  function updateNavFade() {
    if (!navList) return;
    const max = navList.scrollWidth - navList.clientWidth;
    navList.dataset.fadeStart = String(navList.scrollLeft > 2);
    navList.dataset.fadeEnd = String(max - navList.scrollLeft > 2);
  }
  navList?.addEventListener("scroll", updateNavFade, { passive: true });
  if (navList) new ResizeObserver(updateNavFade).observe(navList);

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      const visible = entries.find((entry) => entry.isIntersecting);
      if (visible) {
        setActive(visible.target.id);
      } else if (sections[0] && sections[0].getBoundingClientRect().top > window.innerHeight / 2) {
        // Po skoku na górę "O mnie" nie zgłasza zmiany widoczności
        setActive("");
      }
    },
    { rootMargin: "-45% 0px -50% 0px" }
  );

  sections.forEach((section) => sectionObserver.observe(section));

  const header = document.getElementById("site-header");
  const progress = document.getElementById("scroll-progress");
  const compactScreen = window.matchMedia("(max-width: 1023px), (max-height: 500px)");
  let lastY = 0;
  let ticking = false;

  function onScroll() {
    const y = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const headerHeight = header?.offsetHeight ?? 0;

    const ratio = max > 0 ? Math.min(y / max, 1) : 0;
    if (progress) progress.style.transform = `scaleX(${ratio})`;

    if (header) {
      const delta = y - lastY;
      const pastHeader = y > headerHeight;
      const hasFocus = header.contains(document.activeElement);
      if (!compactScreen.matches || !pastHeader || hasFocus || delta < -4) {
        header.classList.remove("is-hidden");
      } else if (delta > 4) {
        header.classList.add("is-hidden");
      }
    }

    lastY = y;
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true }
  );
  header?.addEventListener("focusin", () => header.classList.remove("is-hidden"));
  // Pomiar po load, żeby nie wymuszać układu w trakcie ładowania
  const initScroll = () => {
    lastY = window.scrollY;
    if (lastY > 0) onScroll();
  };
  if (document.readyState === "complete") initScroll();
  else window.addEventListener("load", initScroll, { once: true });
</script>