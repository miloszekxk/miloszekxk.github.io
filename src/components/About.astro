---
import { getLang, useTranslations } from "../i18n/utils";

const t = useTranslations(getLang(Astro.currentLocale));
---

<section
  id="about"
  data-reveal
  class="mx-auto flex max-w-5xl flex-wrap gap-8 border-t border-line px-6 py-20"
>
  <h2 class="min-w-60 flex-1 font-mono text-3xl font-bold tracking-tight text-fg">
    {t("about.title")}
  </h2>

  <div class="flex-999 min-w-80 space-y-4 text-lg text-fg-soft">
    <p>{t("about.p1")}</p>
    <p>{t("about.p2")}</p>
  </div>
</section>
