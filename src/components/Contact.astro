---
import { site } from "../data/site";
import { getLang, useTranslations } from "../i18n/utils";

const t = useTranslations(getLang(Astro.currentLocale));

const socials = [
  { label: "GitHub", href: site.github },
  { label: "LinkedIn", href: site.linkedin },
].filter((social) => social.href !== "");
---

<section
  id="contact"
  data-reveal
  class="mx-auto flex max-w-5xl flex-col items-start gap-6 border-t border-line px-6 py-24"
>
  <h2 class="font-mono text-4xl font-bold tracking-tight text-fg">
    {t("contact.title")}<span class="text-accent">.</span>
  </h2>

  <p class="max-w-xl text-lg text-fg-soft">
    {t("contact.lead")}
  </p>

  <a
    href={`mailto:${site.email}`}
    class="text-xl font-semibold text-fg transition-colors duration-200 hover:text-accent"
  >
    {site.email}
  </a>

  <div class="flex flex-wrap gap-3">
    {
      socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-md border border-border px-5 text-fg no-underline transition duration-200 hover:-translate-y-0.5 hover:border-fg"
        >
          {social.label}
        </a>
      ))
    }
  </div>
</section>
